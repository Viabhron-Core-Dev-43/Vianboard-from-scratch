<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDiffSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detected changes between sandbox and external database:"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#F8FAFC"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvDiffContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#334155"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proceeding will write the synced changes to the external KDBX file."
        android:textColor="#64748B"
        android:textSize="11sp"
        android:layout_marginTop="8dp" />
</LinearLayout>
