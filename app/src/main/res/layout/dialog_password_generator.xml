<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Generated Result Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F1F5F9"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvGeneratedPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="••••••••••••••••"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnRegenerate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🔄"
            android:background="#E2E8F0"
            android:textSize="12sp"
            android:layout_marginStart="6dp" />

        <Button
            android:id="@+id/btnCopyGenerated"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="📋"
            android:background="#E2E8F0"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEntropyRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rating: Strong (~85 bits entropy)"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

    <!-- Mode Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Passphrase Mode (Memorable Words)"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/switchPassphraseMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Character Options -->
    <LinearLayout
        android:id="@+id/layoutPasswordOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Length: 16 characters"
            android:textColor="#475569"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekBarLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48"
            android:progress="8"
            android:layout_marginVertical="6dp" />

        <CheckBox
            android:id="@+id/cbUppercase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uppercase (A-Z)"
            android:checked="true"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbLowercase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lowercase (a-z)"
            android:checked="true"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbDigits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digits (0-9)"
            android:checked="true"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbSymbols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Symbols (!@#$%)"
            android:checked="true"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
