<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Back"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="#E2E8F0"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Layout &amp; Live Preview"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reset"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:background="#F1F5F9"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Top Half: Scrollable Test Input & Sliders -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Interactive Test Typing Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INTERACTIVE TEST FIELD"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingStart="4dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etTestInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Tap keyboard below to test typing..."
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:background="@null"
                    android:maxLines="3"
                    android:inputType="textMultiLine|textNoSuggestions" />

                <ImageView
                    android:id="@+id/btnClearInput"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_clear_edit"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear test text" />
            </LinearLayout>

            <!-- Category: DIMENSIONS & SPACING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIMENSIONS &amp; SPACING"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingStart="4dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="16dp">

                <!-- 1. Key Height -->
                <TextView
                    android:id="@+id/tvHeightLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Key Height: 52 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekKeyHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="35"
                    android:progress="17"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- 2. Corner Radius -->
                <TextView
                    android:id="@+id/tvRadiusLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Corner Radius: 10 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekCornerRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="24"
                    android:progress="10"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- 3. Horizontal Gap -->
                <TextView
                    android:id="@+id/tvHGapLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Horizontal Gap: 5 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekHGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="14"
                    android:progress="5"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- 4. Vertical Gap -->
                <TextView
                    android:id="@+id/tvVGapLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vertical Gap: 5 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekVGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="14"
                    android:progress="5"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <!-- Category: COLOR & CONTRAST -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COLOR &amp; CONTRAST"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingStart="4dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- 5. Special Keys Grey Tone -->
                <TextView
                    android:id="@+id/tvActionGrayLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Special Keys Grey: 40%"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekActionGray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="40"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="12dp" />

                <!-- 6. Enter Key Color -->
                <TextView
                    android:id="@+id/tvEnterColorLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter Key Color: 50%"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekEnterColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Docked Area: Subtle Divider + Full-Width Live Keyboard View -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CBD5E1" />

    <com.example.ime.keyboard.VianKeyboardView
        android:id="@+id/livePreviewKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ECEFF1" />

</LinearLayout>
