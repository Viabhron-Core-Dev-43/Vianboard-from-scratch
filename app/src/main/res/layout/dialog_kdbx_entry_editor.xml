<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title *"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKdbxTitle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. GitHub, Google, Work VPN"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="#F1F5F9"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder / Group"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerKdbxGroup"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#F1F5F9"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username / Email"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKdbxUsername"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. username@example.com"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="#F1F5F9"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etKdbxPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Enter password or generate"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:background="#F1F5F9"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnToggleKdbxPassword"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="👁️"
                android:background="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btnGenerateKdbxPassword"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="⚡ Gen"
                android:textColor="#0284C7"
                android:background="#E0F2FE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URL or App Package"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKdbxUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. https://github.com or com.github.android"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="#F1F5F9"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTP Seed / otpauth:// URI"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKdbxTotp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Base32 seed or otpauth://totp/..."
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="#F1F5F9"
            android:paddingHorizontal="10dp"
            android:textSize="13sp"
            android:singleLine="true"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvKdbxTotpPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No TOTP configured"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKdbxNotes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="Secure encrypted notes..."
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="#F1F5F9"
            android:padding="8dp"
            android:textSize="13sp"
            android:gravity="top|start"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Fields (JSON format)"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKdbxCustomFields"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint='{"Pin": "1234", "Recovery": "xyz"}'
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:background="#F1F5F9"
            android:padding="8dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
